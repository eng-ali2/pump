rules_version = '2';
// قواعد الحماية: انسخ هذا الملف كله والصقه في Firebase > Firestore Database > Rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // علامة "تم الإعداد الأول"
    match /meta/setup {
      allow get: if true;
      allow create: if signedIn() && !setupDone()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      // أول مشرف فقط (قبل الإعداد) — بعدها المشرف هو اللي يضيف الحسابات
      allow create: if (signedIn() && request.auth.uid == uid && !setupDone()
                        && getAfter(/databases/$(database)/documents/meta/setup).data.done == true)
                    || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ربط اسم المستخدم بحساب الدخول (بعد تغيير كلمة المرور من المشرف)
    match /logins/{username} {
      allow get: if true;
      allow write: if isAdmin();
    }

    match /pumps/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    match /readings/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /maint/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
